#!/bin/bash
# 配置向导保存后：更新配置并重启服务使生效
# 向导字段以环境变量形式传入。兼容两种命名（防御 fnOS 是否自动加 wizard_ 前缀）：
#   wizard_port / wizard_docs_path
#   port / docs_path
PORT="${wizard_port:-${port:-8666}}"
# 文档目录：留空 = 应用共享目录；填写 = 外部目录（需先在应用设置 → 目录授权中添加访问权限）
DOCS_PATH="${wizard_docs_path:-${docs_path:-}}"
if [ -z "${DOCS_PATH}" ]; then
    DOCS_PATH="/var/apps/${TRIM_APPNAME}/shares/docsify-docs"
fi

case "${PORT}" in
    ''|*[!0-9]*) PORT=8666 ;;
esac

mkdir -p "${TRIM_PKGVAR}" "${DOCS_PATH}" 2>/dev/null || true
cat > "${TRIM_PKGVAR}/docsify.conf" <<EOF
PORT=${PORT}
DOCS_PATH=${DOCS_PATH}
EOF

# 重启服务使配置生效
SCRIPT_DIR="$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)"
"${SCRIPT_DIR}/main" stop >/dev/null 2>&1 || true
sleep 1
"${SCRIPT_DIR}/main" start || exit 1

exit 0
