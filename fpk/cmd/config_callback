#!/bin/bash
# 配置向导保存后：更新配置并重启服务使生效
# 向导字段以环境变量形式传入：wizard_port / wizard_docs_path

PORT="${wizard_port:-6666}"
DOCS_PATH="${wizard_docs_path:-}"

if [ -z "${DOCS_PATH}" ]; then
    DOCS_PATH="/var/apps/${TRIM_APPNAME}/shares/docs"
fi

case "${PORT}" in
    ''|*[!0-9]*) PORT=6666 ;;
esac

mkdir -p "${TRIM_PKGVAR}" "${DOCS_PATH}"
cat > "${TRIM_PKGVAR}/docsify.conf" <<EOF
PORT=${PORT}
DOCS_PATH=${DOCS_PATH}
EOF

# 重启服务使配置生效
SCRIPT_DIR="$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)"
"${SCRIPT_DIR}/main" stop >/dev/null 2>&1 || true
sleep 1
"${SCRIPT_DIR}/main" start || exit 1

exit 0
