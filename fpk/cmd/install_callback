#!/bin/bash
# 安装后：把向导填写的 端口/文档目录 写入配置，并种入初始文档
# 向导字段以环境变量形式传入：wizard_port / wizard_docs_path

PORT="${wizard_port:-6666}"
DOCS_PATH="${wizard_docs_path:-}"

# 未填文档目录 → 默认应用共享目录（config/resource 声明，安装时自动创建）
if [ -z "${DOCS_PATH}" ]; then
    DOCS_PATH="/var/apps/${TRIM_APPNAME}/shares/docs"
fi

# 校验端口（防御：向导已校验，这里兜底）
case "${PORT}" in
    ''|*[!0-9]*) PORT=6666 ;;
esac

mkdir -p "${TRIM_PKGVAR}" "${DOCS_PATH}"
cat > "${TRIM_PKGVAR}/docsify.conf" <<EOF
PORT=${PORT}
DOCS_PATH=${DOCS_PATH}
EOF

# 首次安装：文档目录无 index.html 时种入 seed（不覆盖用户已有内容）
if [ ! -f "${DOCS_PATH}/index.html" ] && [ -f "${TRIM_APPDEST}/seed-docs/index.html" ]; then
    cp -a "${TRIM_APPDEST}/seed-docs/." "${DOCS_PATH}/"
fi

exit 0
